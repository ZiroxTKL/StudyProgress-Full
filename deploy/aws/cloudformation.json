{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "StudyProgress: React, Spring Boot, HTTPS y PostgreSQL privado en AWS Academy.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "AppSubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "DatabaseSubnetAId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "DatabaseSubnetBId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "LatestAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "DatabasePassword": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 24,
      "MaxLength": 64,
      "AllowedPattern": "[a-zA-Z0-9]+"
    },
    "LabInstanceProfileName": {
      "Type": "String",
      "Default": "LabInstanceProfile"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.micro",
        "t3.small"
      ]
    }
  },
  "Resources": {
    "ArtifactBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "AppSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTP para validacion ACME y HTTPS publico; administracion por SSM.",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0",
            "Description": "Redireccion HTTPS y validacion de certificado"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Web y API HTTPS"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL accesible solo desde StudyProgress.",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "AppSecurityGroup"
        },
        "Description": "Conexion privada desde backend"
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Subredes de RDS para StudyProgress.",
        "SubnetIds": [
          {
            "Ref": "DatabaseSubnetAId"
          },
          {
            "Ref": "DatabaseSubnetBId"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "DatabaseParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "PostgreSQL 16 con conexiones TLS obligatorias.",
        "Family": "postgres16",
        "Parameters": {
          "rds.force_ssl": "1"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "DBInstanceIdentifier": {
          "Fn::Sub": "${AWS::StackName}-db"
        },
        "DBName": "studyprogress",
        "Engine": "postgres",
        "EngineVersion": "16.15",
        "DBInstanceClass": "db.t3.micro",
        "MasterUsername": "spadmin",
        "MasterUserPassword": {
          "Ref": "DatabasePassword"
        },
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "AutoMinorVersionUpgrade": true,
        "BackupRetentionPeriod": 1,
        "CopyTagsToSnapshot": true,
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "DBParameterGroupName": {
          "Ref": "DatabaseParameters"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "EngineLifecycleSupport": "open-source-rds-extended-support-disabled",
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "AppServer": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "LatestAmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "LabInstanceProfileName"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "AppSubnetId"
            },
            "GroupSet": [
              {
                "Ref": "AppSecurityGroup"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\ndnf install -y docker unzip awscli-2\nsystemctl enable --now docker\nsystemctl enable --now amazon-ssm-agent\ninstall -d -m 700 /opt/studyprogress\n"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          },
          {
            "Key": "Name",
            "Value": "StudyProgress"
          }
        ]
      }
    },
    "PublicAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudyProgress"
          },
          {
            "Key": "Environment",
            "Value": "academic"
          }
        ]
      }
    },
    "PublicAddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "PublicAddress",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "AppServer"
        }
      }
    }
  },
  "Outputs": {
    "WebUrl": {
      "Value": {
        "Fn::Sub": "https://${PublicAddress}"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${PublicAddress}/api/v1"
      }
    },
    "InstanceId": {
      "Value": {
        "Ref": "AppServer"
      }
    },
    "ArtifactBucketName": {
      "Value": {
        "Ref": "ArtifactBucket"
      }
    },
    "DatabaseEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    }
  }
}
